general {
	output_format = "i3bar"
	colors = true
	color_good = "#888888"
	color_bad = "#CC1616"
	color_degraded = "#55858E"
	interval = 3
}

order += "volume master"
order += "load"
order += "cpu_usage"
order += "disk /"
order += "disk /data/"
order += "ethernet enp3s0"
order += "time"

volume master {
	device = "default"
	mixer = "Master"
	mixer_idx = 0
	format = "vol: %volume "
	format_muted = "muted (%volume) "
}

load {
	format = "load: %1min"
}

cpu_usage {
	format = "cpu: %usage"
}

disk "/" {
	format = "/:%avail"
}

disk "/data/" {
	format = "/data/:%avail"
}

ethernet enp3s0 {
	# if you use %speed, i3status requires root privileges
	format_up =  "local: %ip"
	format_down = " Ð eth"
}

time {
    format = "%Y-%m-%d %H:%M:%S"
}
